# OmniReach backend — example environment variables
# Copy to .env and fill in real values before running.

# Bind address for the Axum HTTP server
OMNIREACH_ADDR=127.0.0.1:3000

# Static bearer token — frontend sends: Authorization: Bearer <this value>
# Generate a strong random string for production.
OMNIREACH_TOKEN=dev-token

# SQLite database file path
# Use sqlite://:memory: for integration tests
DATABASE_URL=sqlite://omnireach.db

# WABridge daemon base URL (the Rust WhatsApp bridge)
WABRIDGE_BASE_URL=http://localhost:7171

# HTTP timeout for WABridge calls in milliseconds
WABRIDGE_TIMEOUT_MS=5000

# Tracing filter — set to "debug" for verbose logs during development
RUST_LOG=info
